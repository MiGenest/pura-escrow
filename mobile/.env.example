# Copy to .env and fill in. EXPO_PUBLIC_* values are inlined into the app
# bundle, so these are identifiers, not secrets.

# Your Privy app's ID (Privy dashboard → App settings).
EXPO_PUBLIC_PRIVY_APP_ID=

# The ID of a native (Expo) client of that Privy app. Its allowed URL schemes
# must include `pura` (app.json's `scheme`), or OAuth sign-in does not return
# to the app.
EXPO_PUBLIC_PRIVY_CLIENT_ID=
