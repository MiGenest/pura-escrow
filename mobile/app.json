{
  "expo": {
    "name": "Pura",
    "slug": "pura",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "pura",
    "ios": {
      "bundleIdentifier": "com.pura.mobile",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleLocalizations": [
          "en",
          "ka"
        ]
      }
    },
    "android": {
      "package": "com.pura.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#1F7F95",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pura uses your photo library so you can attach a delivery photo as proof this load arrived.",
          "cameraPermission": "Pura uses the camera so you can photograph a delivery as proof this load arrived.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
